{
  "name": "@spartacus/storefinder",
  "version": "221121.11.0",
  "description": "Store finder feature library for Spartacus",
  "keywords": [
    "spartacus",
    "framework",
    "storefront",
    "storefinder"
  ],
  "homepage": "https://github.com/SAP/spartacus",
  "repository": "https://github.com/SAP/spartacus/tree/develop/feature-libs/storefinder",
  "license": "Apache-2.0",
  "exports": {
    "./*": {
      "sass": "./*"
    },
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./types/spartacus-storefinder.d.ts",
      "default": "./fesm2022/spartacus-storefinder.mjs"
    },
    "./assets": {
      "types": "./types/spartacus-storefinder-assets.d.ts",
      "default": "./fesm2022/spartacus-storefinder-assets.mjs"
    },
    "./components": {
      "types": "./types/spartacus-storefinder-components.d.ts",
      "default": "./fesm2022/spartacus-storefinder-components.mjs"
    },
    "./core": {
      "types": "./types/spartacus-storefinder-core.d.ts",
      "default": "./fesm2022/spartacus-storefinder-core.mjs"
    },
    "./occ": {
      "types": "./types/spartacus-storefinder-occ.d.ts",
      "default": "./fesm2022/spartacus-storefinder-occ.mjs"
    },
    "./root": {
      "types": "./types/spartacus-storefinder-root.d.ts",
      "default": "./fesm2022/spartacus-storefinder-root.mjs"
    }
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@angular-devkit/schematics": "^21.2.8",
    "@angular/common": "^21.2.9",
    "@angular/core": "^21.2.9",
    "@angular/forms": "^21.2.9",
    "@angular/router": "^21.2.9",
    "@ngrx/effects": "^21.0.1",
    "@ngrx/store": "^21.0.1",
    "@spartacus/core": "221121.11.0",
    "@spartacus/schematics": "221121.11.0",
    "@spartacus/storefront": "221121.11.0",
    "@spartacus/styles": "221121.11.0",
    "rxjs": "^7.8.0"
  },
  "engines": {
    "node": "^22.22.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "schematics": "./schematics/collection.json",
  "module": "fesm2022/spartacus-storefinder.mjs",
  "typings": "types/spartacus-storefinder.d.ts",
  "sideEffects": false
}