{
  "name": "@spartacus/asm",
  "version": "221121.11.0",
  "description": "ASM feature library for Spartacus",
  "keywords": [
    "spartacus",
    "framework",
    "storefront",
    "asm"
  ],
  "homepage": "https://github.com/SAP/spartacus",
  "repository": "https://github.com/SAP/spartacus/tree/develop/feature-libs/asm",
  "license": "Apache-2.0",
  "exports": {
    "./*": {
      "sass": "./*"
    },
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./types/spartacus-asm.d.ts",
      "default": "./fesm2022/spartacus-asm.mjs"
    },
    "./assets": {
      "types": "./types/spartacus-asm-assets.d.ts",
      "default": "./fesm2022/spartacus-asm-assets.mjs"
    },
    "./components": {
      "types": "./types/spartacus-asm-components.d.ts",
      "default": "./fesm2022/spartacus-asm-components.mjs"
    },
    "./core": {
      "types": "./types/spartacus-asm-core.d.ts",
      "default": "./fesm2022/spartacus-asm-core.mjs"
    },
    "./customer-360": {
      "types": "./types/spartacus-asm-customer-360.d.ts",
      "default": "./fesm2022/spartacus-asm-customer-360.mjs"
    },
    "./customer-360/assets": {
      "types": "./types/spartacus-asm-customer-360-assets.d.ts",
      "default": "./fesm2022/spartacus-asm-customer-360-assets.mjs"
    },
    "./customer-360/components": {
      "types": "./types/spartacus-asm-customer-360-components.d.ts",
      "default": "./fesm2022/spartacus-asm-customer-360-components.mjs"
    },
    "./customer-360/core": {
      "types": "./types/spartacus-asm-customer-360-core.d.ts",
      "default": "./fesm2022/spartacus-asm-customer-360-core.mjs"
    },
    "./customer-360/occ": {
      "types": "./types/spartacus-asm-customer-360-occ.d.ts",
      "default": "./fesm2022/spartacus-asm-customer-360-occ.mjs"
    },
    "./customer-360/root": {
      "types": "./types/spartacus-asm-customer-360-root.d.ts",
      "default": "./fesm2022/spartacus-asm-customer-360-root.mjs"
    },
    "./occ": {
      "types": "./types/spartacus-asm-occ.d.ts",
      "default": "./fesm2022/spartacus-asm-occ.mjs"
    },
    "./root": {
      "types": "./types/spartacus-asm-root.d.ts",
      "default": "./fesm2022/spartacus-asm-root.mjs"
    }
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@angular-devkit/schematics": "^21.2.8",
    "@angular/common": "^21.2.9",
    "@angular/core": "^21.2.9",
    "@angular/forms": "^21.2.9",
    "@ng-select/ng-select": "^21.1.4",
    "@ngrx/effects": "^21.0.1",
    "@ngrx/store": "^21.0.1",
    "@spartacus/cart": "221121.11.0",
    "@spartacus/core": "221121.11.0",
    "@spartacus/order": "221121.11.0",
    "@spartacus/schematics": "221121.11.0",
    "@spartacus/storefinder": "221121.11.0",
    "@spartacus/storefront": "221121.11.0",
    "@spartacus/styles": "221121.11.0",
    "@spartacus/user": "221121.11.0",
    "rxjs": "^7.8.0"
  },
  "engines": {
    "node": "^22.22.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "schematics": "./schematics/collection.json",
  "module": "fesm2022/spartacus-asm.mjs",
  "typings": "types/spartacus-asm.d.ts",
  "sideEffects": false
}