{
  "name": "@spartacus/tracking",
  "version": "221121.11.0",
  "description": "Spartacus tracking and personalization library",
  "keywords": [
    "spartacus",
    "framework",
    "storefront",
    "tracking",
    "tms",
    "adobe launch",
    "gtm",
    "personalization"
  ],
  "homepage": "https://github.com/SAP/spartacus",
  "repository": "https://github.com/SAP/spartacus/tree/develop/feature-libs/tracking",
  "license": "Apache-2.0",
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@angular-devkit/schematics": "^21.2.8",
    "@angular/common": "^21.2.9",
    "@angular/core": "^21.2.9",
    "@spartacus/core": "221121.11.0",
    "@spartacus/schematics": "221121.11.0",
    "rxjs": "^7.8.0"
  },
  "engines": {
    "node": "^22.22.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "schematics": "./schematics/collection.json",
  "module": "fesm2022/spartacus-tracking.mjs",
  "typings": "types/spartacus-tracking.d.ts",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./types/spartacus-tracking.d.ts",
      "default": "./fesm2022/spartacus-tracking.mjs"
    },
    "./personalization": {
      "types": "./types/spartacus-tracking-personalization.d.ts",
      "default": "./fesm2022/spartacus-tracking-personalization.mjs"
    },
    "./personalization/core": {
      "types": "./types/spartacus-tracking-personalization-core.d.ts",
      "default": "./fesm2022/spartacus-tracking-personalization-core.mjs"
    },
    "./personalization/root": {
      "types": "./types/spartacus-tracking-personalization-root.d.ts",
      "default": "./fesm2022/spartacus-tracking-personalization-root.mjs"
    },
    "./tms": {
      "types": "./types/spartacus-tracking-tms.d.ts",
      "default": "./fesm2022/spartacus-tracking-tms.mjs"
    },
    "./tms/aep": {
      "types": "./types/spartacus-tracking-tms-aep.d.ts",
      "default": "./fesm2022/spartacus-tracking-tms-aep.mjs"
    },
    "./tms/core": {
      "types": "./types/spartacus-tracking-tms-core.d.ts",
      "default": "./fesm2022/spartacus-tracking-tms-core.mjs"
    },
    "./tms/gtm": {
      "types": "./types/spartacus-tracking-tms-gtm.d.ts",
      "default": "./fesm2022/spartacus-tracking-tms-gtm.mjs"
    }
  },
  "sideEffects": false
}