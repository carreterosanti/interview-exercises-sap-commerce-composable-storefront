{
  "name": "@spartacus/order",
  "version": "221121.11.0",
  "description": "Order feature library for Spartacus",
  "keywords": [
    "spartacus",
    "framework",
    "storefront",
    "order"
  ],
  "homepage": "https://github.com/SAP/spartacus",
  "repository": "https://github.com/SAP/spartacus/tree/develop/feature-libs/order",
  "license": "Apache-2.0",
  "exports": {
    "./*": {
      "sass": "./*"
    },
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./types/spartacus-order.d.ts",
      "default": "./fesm2022/spartacus-order.mjs"
    },
    "./assets": {
      "types": "./types/spartacus-order-assets.d.ts",
      "default": "./fesm2022/spartacus-order-assets.mjs"
    },
    "./components": {
      "types": "./types/spartacus-order-components.d.ts",
      "default": "./fesm2022/spartacus-order-components.mjs"
    },
    "./core": {
      "types": "./types/spartacus-order-core.d.ts",
      "default": "./fesm2022/spartacus-order-core.mjs"
    },
    "./document-flow": {
      "types": "./types/spartacus-order-document-flow.d.ts",
      "default": "./fesm2022/spartacus-order-document-flow.mjs"
    },
    "./document-flow/assets": {
      "types": "./types/spartacus-order-document-flow-assets.d.ts",
      "default": "./fesm2022/spartacus-order-document-flow-assets.mjs"
    },
    "./document-flow/components": {
      "types": "./types/spartacus-order-document-flow-components.d.ts",
      "default": "./fesm2022/spartacus-order-document-flow-components.mjs"
    },
    "./document-flow/core": {
      "types": "./types/spartacus-order-document-flow-core.d.ts",
      "default": "./fesm2022/spartacus-order-document-flow-core.mjs"
    },
    "./document-flow/occ": {
      "types": "./types/spartacus-order-document-flow-occ.d.ts",
      "default": "./fesm2022/spartacus-order-document-flow-occ.mjs"
    },
    "./document-flow/root": {
      "types": "./types/spartacus-order-document-flow-root.d.ts",
      "default": "./fesm2022/spartacus-order-document-flow-root.mjs"
    },
    "./occ": {
      "types": "./types/spartacus-order-occ.d.ts",
      "default": "./fesm2022/spartacus-order-occ.mjs"
    },
    "./root": {
      "types": "./types/spartacus-order-root.d.ts",
      "default": "./fesm2022/spartacus-order-root.mjs"
    }
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@angular-devkit/schematics": "^21.2.8",
    "@angular/common": "^21.2.9",
    "@angular/core": "^21.2.9",
    "@angular/forms": "^21.2.9",
    "@angular/router": "^21.2.9",
    "@ng-select/ng-select": "^21.1.4",
    "@ngrx/effects": "^21.0.1",
    "@ngrx/store": "^21.0.1",
    "@spartacus/cart": "221121.11.0",
    "@spartacus/core": "221121.11.0",
    "@spartacus/pdf-invoices": "221121.11.0",
    "@spartacus/schematics": "221121.11.0",
    "@spartacus/storefront": "221121.11.0",
    "@spartacus/styles": "221121.11.0",
    "@spartacus/user": "221121.11.0",
    "rxjs": "^7.8.0"
  },
  "engines": {
    "node": "^22.22.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "schematics": "./schematics/collection.json",
  "module": "fesm2022/spartacus-order.mjs",
  "typings": "types/spartacus-order.d.ts",
  "sideEffects": false
}