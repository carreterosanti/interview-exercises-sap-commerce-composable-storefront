{
  "name": "@spartacus/user",
  "version": "221121.11.0",
  "description": "User feature library for Spartacus",
  "keywords": [
    "spartacus",
    "framework",
    "storefront",
    "user"
  ],
  "homepage": "https://github.com/SAP/spartacus",
  "repository": "https://github.com/SAP/spartacus/tree/develop/feature-libs/user",
  "license": "Apache-2.0",
  "exports": {
    "./*": {
      "sass": "./*"
    },
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./types/spartacus-user.d.ts",
      "default": "./fesm2022/spartacus-user.mjs"
    },
    "./account": {
      "types": "./types/spartacus-user-account.d.ts",
      "default": "./fesm2022/spartacus-user-account.mjs"
    },
    "./account/assets": {
      "types": "./types/spartacus-user-account-assets.d.ts",
      "default": "./fesm2022/spartacus-user-account-assets.mjs"
    },
    "./account/components": {
      "types": "./types/spartacus-user-account-components.d.ts",
      "default": "./fesm2022/spartacus-user-account-components.mjs"
    },
    "./account/core": {
      "types": "./types/spartacus-user-account-core.d.ts",
      "default": "./fesm2022/spartacus-user-account-core.mjs"
    },
    "./account/occ": {
      "types": "./types/spartacus-user-account-occ.d.ts",
      "default": "./fesm2022/spartacus-user-account-occ.mjs"
    },
    "./account/root": {
      "types": "./types/spartacus-user-account-root.d.ts",
      "default": "./fesm2022/spartacus-user-account-root.mjs"
    },
    "./profile": {
      "types": "./types/spartacus-user-profile.d.ts",
      "default": "./fesm2022/spartacus-user-profile.mjs"
    },
    "./profile/assets": {
      "types": "./types/spartacus-user-profile-assets.d.ts",
      "default": "./fesm2022/spartacus-user-profile-assets.mjs"
    },
    "./profile/components": {
      "types": "./types/spartacus-user-profile-components.d.ts",
      "default": "./fesm2022/spartacus-user-profile-components.mjs"
    },
    "./profile/core": {
      "types": "./types/spartacus-user-profile-core.d.ts",
      "default": "./fesm2022/spartacus-user-profile-core.mjs"
    },
    "./profile/occ": {
      "types": "./types/spartacus-user-profile-occ.d.ts",
      "default": "./fesm2022/spartacus-user-profile-occ.mjs"
    },
    "./profile/root": {
      "types": "./types/spartacus-user-profile-root.d.ts",
      "default": "./fesm2022/spartacus-user-profile-root.mjs"
    }
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@angular-devkit/schematics": "^21.2.8",
    "@angular/common": "^21.2.9",
    "@angular/core": "^21.2.9",
    "@angular/forms": "^21.2.9",
    "@angular/router": "^21.2.9",
    "@ng-select/ng-select": "^21.1.4",
    "@ngrx/store": "^21.0.1",
    "@spartacus/core": "221121.11.0",
    "@spartacus/schematics": "221121.11.0",
    "@spartacus/storefront": "221121.11.0",
    "@spartacus/styles": "221121.11.0",
    "rxjs": "^7.8.0"
  },
  "engines": {
    "node": "^22.22.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "schematics": "./schematics/collection.json",
  "module": "fesm2022/spartacus-user.mjs",
  "typings": "types/spartacus-user.d.ts",
  "sideEffects": false
}