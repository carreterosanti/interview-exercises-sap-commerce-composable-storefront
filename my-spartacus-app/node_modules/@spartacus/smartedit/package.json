{
  "name": "@spartacus/smartedit",
  "version": "221121.11.0",
  "description": "Smart Edit feature library for Spartacus",
  "keywords": [
    "spartacus",
    "framework",
    "storefront",
    "smartedit"
  ],
  "homepage": "https://github.com/SAP/spartacus",
  "repository": "https://github.com/SAP/spartacus/tree/develop/feature-libs/smartedit",
  "license": "Apache-2.0",
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@angular-devkit/schematics": "^21.2.8",
    "@angular/common": "^21.2.9",
    "@angular/core": "^21.2.9",
    "@spartacus/core": "221121.11.0",
    "@spartacus/schematics": "221121.11.0",
    "rxjs": "^7.8.0"
  },
  "engines": {
    "node": "^22.22.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "schematics": "./schematics/collection.json",
  "module": "fesm2022/spartacus-smartedit.mjs",
  "typings": "types/spartacus-smartedit.d.ts",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./types/spartacus-smartedit.d.ts",
      "default": "./fesm2022/spartacus-smartedit.mjs"
    },
    "./core": {
      "types": "./types/spartacus-smartedit-core.d.ts",
      "default": "./fesm2022/spartacus-smartedit-core.mjs"
    },
    "./root": {
      "types": "./types/spartacus-smartedit-root.d.ts",
      "default": "./fesm2022/spartacus-smartedit-root.mjs"
    }
  },
  "sideEffects": false
}