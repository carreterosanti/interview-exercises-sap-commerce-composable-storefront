  "engines": {
    "node": "^22.22.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "schematics": "./schematics/collection.json",
  "module": "fesm2022/spartacus-product-multi-dimensional.mjs",
  "typings": "types/spartacus-product-multi-dimensional.d.ts",
