      "default": "./fesm2022/spartacus-product-multi-dimensional-list.mjs"
    },
    "./list/root": {
      "types": "./types/spartacus-product-multi-dimensional-list-root.d.ts",
      "default": "./fesm2022/spartacus-product-multi-dimensional-list-root.mjs"
    },
    "./selector": {
      "types": "./types/spartacus-product-multi-dimensional-selector.d.ts",
      "default": "./fesm2022/spartacus-product-multi-dimensional-selector.mjs"
    },
    "./selector/assets": {
      "types": "./types/spartacus-product-multi-dimensional-selector-assets.d.ts",
      "default": "./fesm2022/spartacus-product-multi-dimensional-selector-assets.mjs"
    },
    "./selector/components": {
      "types": "./types/spartacus-product-multi-dimensional-selector-components.d.ts",
      "default": "./fesm2022/spartacus-product-multi-dimensional-selector-components.mjs"
    },
    "./selector/core": {
      "types": "./types/spartacus-product-multi-dimensional-selector-core.d.ts",
      "default": "./fesm2022/spartacus-product-multi-dimensional-selector-core.mjs"
    },
    "./selector/occ": {
      "types": "./types/spartacus-product-multi-dimensional-selector-occ.d.ts",
