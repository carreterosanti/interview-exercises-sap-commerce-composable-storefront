      "default": "./fesm2022/spartacus-requested-delivery-date-core.mjs"
    },
    "./occ": {
      "types": "./types/spartacus-requested-delivery-date-occ.d.ts",
      "default": "./fesm2022/spartacus-requested-delivery-date-occ.mjs"
    },
    "./root": {
